# Server
ENV=development
SERVER_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# Data
DB_PATH=./data/app.db
DATA_DIR=./data

# Auth
JWT_SECRET=change-me-please-use-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Seed (first run only)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@giodevportal.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_DEMO=true

# Google Gemini (leave empty to use deterministic mock)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WhatsApp Business API (leave empty to log notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_TICKET_ALERT=ticket_alert
WHATSAPP_TEMPLATE_RESOURCE_ALERT=resource_alert
WHATSAPP_TEMPLATE_PAYMENT_ALERT=payment_alert
WHATSAPP_TEMPLATE_SRS_ALERT=srs_request_alert
ADMIN_WHATSAPP_NUMBER=

# Cloudflare R2 (leave empty to store files on local disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=giodevportal-files
R2_PUBLIC_URL=

# Resend (leave empty to log emails)
RESEND_API_KEY=
EMAIL_FROM=GioDevPortal <noreply@localhost>
